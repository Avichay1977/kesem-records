# Kesem Records is the main site. DoGBeaT lives inside it at /dogbeat/.
# Rules without "!" only apply when no real page exists at that address.

# Old Kesem addresses that were served under /studio/ on the DoGBeaT site
/studio                              /                                         301
/studio/*                            /:splat                                   301

# DoGBeaT pages that used to live at the root of dogbeat.netlify.app
# The legacy host can add /dogbeat/ to links that already contain that prefix.
/dogbeat/dogbeat                     /dogbeat/                                 301
/dogbeat/dogbeat/*                   /dogbeat/:splat                           301
/credits                             /dogbeat/credits/                         301
/credits/*                           /dogbeat/credits/:splat                   301
/music-production                    /dogbeat/music-production/                301
/music-production/*                  /dogbeat/music-production/:splat          301
/music-for-film-tv-advertising       /dogbeat/music-for-film-tv-advertising/   301
/music-for-film-tv-advertising/*     /dogbeat/music-for-film-tv-advertising/:splat 301
/ai-technology                       /dogbeat/ai-technology/                   301
/ai-technology/*                     /dogbeat/ai-technology/:splat             301
/assets/*                            /dogbeat/assets/:splat                    301

# /music/ is the Kesem music page; the DoGBeaT track pages moved to /dogbeat/music/
https://kesem-records.netlify.app/music/                   https://kesemrecords.com/music/ 301!
http://kesem-records.netlify.app/music/                   https://kesemrecords.com/music/ 301!
/music/*                             /dogbeat/music/:splat                     301

# The old content editor edits files that are no longer shown on the site, so it stays closed
/admin                               /                                         302!
/admin/*                             /                                         302!

