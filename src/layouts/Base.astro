---
import settings from '../data/settings.json';

interface Props {
  title?: string;
  description?: string;
}

const { title = settings.siteTitle, description = settings.siteDescription } = Astro.props;
const canonicalPath = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : Astro.url.pathname + '/';
const canonical = new URL(canonicalPath, settings.brand.studioUrl).toString();
const studioIdentity = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': settings.brand.studioUrl + '#organization',
      name: 'Kesem Records', url: settings.brand.studioUrl,
      founder: { '@id': settings.brand.personId } },
    { '@type': 'Person', '@id': settings.brand.personId,
      name: settings.brand.personName, alternateName: settings.brand.alternateNames,
      url: settings.brand.artistUrl,
      sameAs: ['https://www.youtube.com/@DoGBeaT77', 'https://open.spotify.com/artist/2IXn2t9xdU4FNiy394DBP4'] },
    { '@type': 'WebPage', '@id': canonical + '#webpage', url: canonical, name: title,
      about: [{ '@id': settings.brand.personId }, { '@id': settings.brand.studioUrl + '#organization' }] }
  ]
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify(studioIdentity)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
  </head>
  <body>
    <header class="header">
      <nav>
        <a href="/" class="logo" data-editable data-file="settings" data-path="nav.logoText">{settings.nav.logoText}</a>
        <div class="nav-links">
          {settings.nav.links.map((link) => (
            <a href={link.url}>{link.label}</a>
          ))}
        </div>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="footer">
      <p data-editable data-file="settings" data-path="footer.text">&copy; {new Date().getFullYear()} {settings.footer.text}</p>
      <p><a href="https://dogbeat.netlify.app/" rel="noopener">DoGBeaT — producer &amp; composer</a> · <a href="https://dogbeat.netlify.app/credits/" rel="noopener">Source-linked credits</a></p>
    </footer>

    <button class="theme-toggle" id="themeToggle" aria-label="Switch theme">
      C64
    </button>

    <script is:inline>
      (function() {
        const saved = localStorage.getItem('theme');
        if (saved === 'commodore') {
          document.documentElement.setAttribute('data-theme', 'commodore');
        }

        document.addEventListener('DOMContentLoaded', function() {
          const btn = document.getElementById('themeToggle');
          function updateLabel() {
            const current = document.documentElement.getAttribute('data-theme');
            btn.textContent = current === 'commodore' ? 'B&W' : 'C64';
          }
          updateLabel();

          btn.addEventListener('click', function() {
            const current = document.documentElement.getAttribute('data-theme');
            if (current === 'commodore') {
              document.documentElement.removeAttribute('data-theme');
              localStorage.setItem('theme', 'typewriter');
            } else {
              document.documentElement.setAttribute('data-theme', 'commodore');
              localStorage.setItem('theme', 'commodore');
            }
            updateLabel();
          });
        });
      })();
    </script>
    <script src="/scripts/inline-editor.js" defer></script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .header {
    padding: 2rem 1.5rem;
    border-bottom: 1px solid var(--border);
  }

  nav {
    max-width: var(--max-width);
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .logo {
    font-size: 1.1rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    border-bottom: none;
  }

  .nav-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1rem;
    max-width: 100%;
  }

  .nav-links a {
    font-size: 0.85rem;
    text-transform: lowercase;
    letter-spacing: 0.08em;
  }

  main {
    flex: 1;
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 3rem 1.5rem;
    width: 100%;
  }

  .footer {
    padding: 2rem 1.5rem;
    border-top: 1px solid var(--border);
    text-align: center;
    font-size: 0.75rem;
    color: var(--accent);
    letter-spacing: 0.05em;
  }

  @media (max-width: 480px) {
    .header {
      padding: 1.5rem 1rem;
    }

    nav {
      flex-direction: column;
      gap: 1rem;
    }

    main {
      padding: 2rem 1rem;
    }
  }
</style>