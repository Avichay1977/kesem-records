---
import CatalogProjects from '../components/CatalogProjects.astro';
import CatalogWork from '../components/CatalogWork.astro';

const artists = [
  'Avichai Tuchman',
  'Balkan Beat Box',
  'DoGBeaT',
  'DoGBeaT & Artlist Classics',
  'DoGBeaT feat. Artlist Classics',
  'Everest feat. Renana Ne’eman',
  'Haze’evot',
  'Hemi Rudner',
  'Ido Shenzur',
  'Kof Snae',
  'Loren Milk',
  'Noa Faran & DoGBeaT',
  'Noam Rotem',
  'Rafi Adar',
  'Reines Girls',
  'Roei Freilich',
  'Shay Lahav & Ran Golani',
  'Shlomi Shaban',
  'Shuli Rand'
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="robots" content="index,follow" />
    <meta name="description" content="Selected work by Avichai Tuchman / DoGBeaT — production, performance, original music and remixes." />
    <title>Kesem Records — Avichai Tuchman / DoGBeaT</title>
    <link rel="stylesheet" href="/catalog.css" />
  </head>
  <body>
    <header class="preview-nav">
      <div class="preview-nav-inner">
        <a aria-label="Kesem Records home" class="preview-brand" href="#kc-title"><span class="brand-text">KESEM RECORDS</span></a>
        <nav aria-label="Main" class="preview-links">
          <a href="#kc-projects">Projects</a>
          <a href="#kc-work">Production &amp; Performance</a>
          <a href="/about/">About</a>
        </nav>
      </div>
    </header>

    <main>
      <div class="kr-catalog" data-kc-root>
        <header class="kc-intro">
          <p class="kc-eyebrow">AVICHAI TUCHMAN / DoGBeaT</p>
          <h1 id="kc-title">Music.</h1>
        </header>

        <details class="kc-search-panel">
          <summary>Search the catalogue <span aria-hidden="true">+</span></summary>
          <form class="kc-search" data-kc-controls hidden role="search">
            <label for="kc-search">Find a record
              <span class="kc-search-input-wrap"><input autocomplete="off" data-kc-search-input dir="auto" id="kc-search" placeholder="Artist, song or album…" type="search" /></span>
            </label>
            <label for="kc-artist">Artist
              <select data-kc-artist-select id="kc-artist">
                <option value="">All artists</option>
                {artists.map((artist) => <option>{artist}</option>)}
              </select>
            </label>
            <button type="reset">Clear filters</button>
          </form>
          <p class="kc-results" data-kc-status role="status">30 releases</p>
        </details>
        <noscript><p>All releases are listed below. Enable JavaScript for filtering and in-page playback.</p></noscript>

        <CatalogProjects />
        <CatalogWork />

        <footer class="kc-archive-foot">
          <p>Selected catalogue · Avichai Tuchman / DoGBeaT</p>
          <p>YouTube and Spotify players open inside this page whenever an embeddable source is available.</p>
        </footer>
      </div>
    </main>

    <footer class="preview-footer">KESEM RECORDS · TEL AVIV</footer>
    <script is:inline src="/catalog.js"></script>
  </body>
</html>